flowchart TD

    %% Cores e Estilizações Customizadas (Paleta Premium)
    classDef businessData fill:#1a1c29,stroke:#4C566A,stroke-width:1px,color:#D8DEE9
    classDef engine fill:#5E81AC,stroke:#88C0D0,stroke-width:2px,color:#FFF
    classDef aiCore fill:#BF616A,stroke:#D08770,stroke-width:2px,color:#FFF
    classDef cloud fill:#4C566A,stroke:#D8DEE9,stroke-dasharray: 5 5,color:#FFF
    classDef interface fill:#EBCB8B,stroke:#D08770,stroke-width:2px,color:#2E3440

    subgraph MFS_SYSTEM [MOTOR MFS: ECOSSISTEMA DE INTELIGÊNCIA DE CRÉDITO]
        direction TB

        subgraph Ingestion [1. Ingestão & Macroeconomia]
            direction LR
            B[Transações de Boletos]:::businessData
            A[Dados Cadastrais FIDC]:::businessData
            BACEN((Indicadores BACEN\nSelic & IPCA)):::engine
        end

        subgraph GraphEngine [2. Engenharia de Redes & Contágio]
            direction TB
            ETL[Higienização de Dados]:::engine
            Neo[(Grafo Financeiro\nNeo4j AuraDB)]:::engine
            RiskNet[Análise de Contágio Sistêmico]:::engine
            
            B --> ETL
            A --> ETL
            ETL --> Neo
            Neo -.->|Mapeamento de Redes| RiskNet
        end

        subgraph AICore [3. Inteligência Preditiva & Políticas]
            direction TB
            Merge[Consolidação de Variáveis]:::engine
            ML[Cérebro IA: PD & Atraso]:::aiCore
            SHAP[Explicabilidade de Decisões]:::aiCore
            YAML[Políticas de Risco Dinâmicas]:::businessData
            
            ETL --> Merge
            BACEN --> Merge
            RiskNet --> Merge
            Merge --> ML
            ML --> SHAP
            Merge --> YAML
        end

        subgraph CloudInfra [4. Cloud Gateway & Segurança]
            direction LR
            API{API de Serviços de Risco\nFastAPI & Segurança JWT}:::engine
            GCS[(Armazenamento Seguro\nGoogle Cloud Storage)]:::cloud
            
            ML -.->|Sincronização| GCS
            GCS -.->|Entrega| API
            SHAP --> API
            YAML --> API
        end

        subgraph Delivery [5. Visão de Negócio & Mesa de Crédito]
            direction TB
            Cockpit[Cockpit Estratégico\nPerformance da Carteira]:::interface
            NetViz[Mapa de Risco Sistêmico]:::interface
            Ops[Mesa de Operações\nDecisões Assistidas]:::interface
            Gov[Monitor de Governança\nAuditoria & Drift]:::interface
            
            API <-->|Insights em Tempo Real| Cockpit
            API <-->|Teia de Conectividade| NetViz
            API <-->|Ação & Feedback Loop| Ops
            API -->|Métricas de Confiança| Gov
        end

    end

    %% Conexões entre camadas principais
    Ingestion --> GraphEngine
    GraphEngine --> AICore
    AICore --> CloudInfra
    CloudInfra --> Delivery
