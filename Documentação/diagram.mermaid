flowchart TD

    %% Cores e Estilizações Customizadas (Paleta Premium)
    classDef businessData fill:#1a1c29,stroke:#4C566A,stroke-width:1px,color:#D8DEE9
    classDef engine fill:#5E81AC,stroke:#88C0D0,stroke-width:2px,color:#FFF
    classDef aiCore fill:#BF616A,stroke:#D08770,stroke-width:2px,color:#FFF
    classDef cloud fill:#4C566A,stroke:#D8DEE9,stroke-dasharray: 5 5,color:#FFF
    classDef interface fill:#EBCB8B,stroke:#D08770,stroke-width:2px,color:#2E3440

    subgraph MFS_SYSTEM [MOTOR MFS: ECOSSISTEMA DE INTELIGÊNCIA DE CRÉDITO]
        direction TB

        subgraph Ingestion [1. Ingestão de Dados Transacionais]
            direction LR
            B[Transações de Boletos]:::businessData
            A[Dados Cadastrais FIDC]:::businessData
            Raw[(Repositório /data/raw)]:::businessData
            
            B --> Raw
            A --> Raw
        end

        subgraph PipelineOrchestra [2. Orquestração & Redes de Risco]
            direction TB
            RunAll[["run_pipeline.py (Orquestrador)"]]:::engine
            ETL[limpeza.py (Saneamento)]:::engine
            Neo[(Neo4j AuraDB Cloud)]:::engine
            RiskNet[Métricas de Contágio Sistêmico]:::engine
            
            Raw --> RunAll
            RunAll --> ETL
            ETL --> Neo
            Neo -.->|PageRank & Centralidade| RiskNet
        end

        subgraph AICore [3. Inteligência Preditiva & Políticas]
            direction TB
            Merge[montar_base_modelagem.py]:::engine
            ML[Cérebro IA: PD & Probabilidade]:::aiCore
            SHAP[explicabilidade.py (XAI)]:::aiCore
            YAML[politica_risco.yaml (Regras de Negócio)]:::businessData
            
            ETL --> Merge
            RiskNet --> Merge
            Merge --> ML
            ML --> SHAP
            Merge --> YAML
        end

        subgraph CloudInfra [4. Cloud Runtime & Storage]
            direction LR
            API{FastAPI Gateway\nCloud Run}:::engine
            GCS[(Google Cloud Storage\nModel persistence)]:::cloud
            
            ML -.->|Sincronização .joblib| GCS
            GCS -.->|Hot-Reload Assets| API
            SHAP --> API
            YAML --> API
        end

        subgraph Delivery [5. Entrega & Mesa de Crédito]
            direction TB
            Cockpit[Cockpit Estratégico React]:::interface
            NetViz[Visualização de Grafo D3]:::interface
            Ops[Mesa de Operações\nJustificativa SHAP]:::interface
            Report[Relatórios de Pipeline]:::interface
            
            API <-->|JSON Stream| Cockpit
            API <-->|Relational Data| NetViz
            API <-->|Ação & Feedback| Ops
            API -->|Pipeline Report| Report
        end

    end

    %% Conexões entre camadas principais
    Ingestion --> PipelineOrchestra
    PipelineOrchestra --> AICore
    AICore --> CloudInfra
    CloudInfra --> Delivery
