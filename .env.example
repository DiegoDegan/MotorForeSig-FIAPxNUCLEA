# -------------------------------------------------------------
# IDENTIFICAÇÃO DE AMBIENTE
# -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# -------------------------------------------------------------
# BANCO DE DADOS EM GRAFO (NEO4J + GDS)
# -------------------------------------------------------------
# Padrão para Docker Local (recomendado para uso com GDS - ver docker-compose.yml):
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nuclea
NEO4J_DATABASE=neo4j

# Alternativa: Neo4j AuraDB na Nuvem (sem suporte nativo a GDS no plano Free)
# NEO4J_URI=neo4j+s://<seu-instance-id>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<sua-senha-aura>
# NEO4J_DATABASE=neo4j

# -------------------------------------------------------------
# SEGURANÇA & AUTENTICAÇÃO (FASTAPI JWT)
# -------------------------------------------------------------
API_SECRET_KEY=7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f1a2b3c4d5e6f7a8b9c0d
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=1440
API_ADMIN_USER=admin_mfs
API_ADMIN_PASSWORD=nuclea_segura_2024

# -------------------------------------------------------------
# PARÂMETROS DE MOTOR DE RISCO (HARD RULES / THRESHOLDS)
# -------------------------------------------------------------
MAX_PD_THRESHOLD=0.35
DIAS_ATRASO_DEFAULT=60

# -------------------------------------------------------------
# INTEGRAÇÕES OPCIONAIS (GCP / BACEN / WANDB)
# -------------------------------------------------------------
# Google Cloud Platform (se sincronizar ativos com Cloud Storage)
GCP_PROJECT_ID=nuclea-mfs-prod
GCP_REGION=southamerica-east1
# GCP_BUCKET_NAME=nuclea-mfs-assets-8138

# Banco Central (BACEN)
BACEN_API_BASE_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs
# BACEN_API_KEY=<sua-chave-opcional>

# Weights & Biases (MLOps Tracking)
# WANDB_API_KEY=<sua-chave-wandb>
# WANDB_PROJECT=nuclea-mfs-risk
