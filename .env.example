# -------------------------------------------------------------
# IDENTIFICAÇÃO DE AMBIENTE
# -------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# -------------------------------------------------------------
# GOOGLE CLOUD PLATFORM (GCP)
# -------------------------------------------------------------
GCP_PROJECT_ID=nuclea-mfs-prod
GCP_REGION=southamerica-east1
# Opcional (se rodar fora do GCP, usar credenciais de serviço)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# -------------------------------------------------------------
# CONEXÃO NEO4J AURADB
# -------------------------------------------------------------
NEO4J_URI=neo4j+s://<seu-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<SUA_SENHA_SEGURA_AURA>
NEO4J_DATABASE=neo4j

# -------------------------------------------------------------
# APIS EXTERNAS BANCÁRIAS (BACEN)
# -------------------------------------------------------------
BACEN_API_BASE_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs
# Chave de acesso caso consuma endpoints privados ou com rate-limit
BACEN_API_KEY=<sua-chave-aqui>

# -------------------------------------------------------------
# PARÂMETROS DE MOTOR DE RISCO (HARD RULES / THRESHOLDS)
# -------------------------------------------------------------
MAX_PD_THRESHOLD=0.35
DIAS_ATRASO_DEFAULT=60
